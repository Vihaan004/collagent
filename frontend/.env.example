# Copy to .env.local for local dev (and set the same vars in Vercel for prod).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Major-map onboarding steps. Disabled by default for the demo deploy; set to true
# (with backend MAJOR_MAP_ENABLED=true) to restore the "Build map" + course-editor steps.
NEXT_PUBLIC_MAJOR_MAP_ENABLED=false
