###########################################################################
# Secrets
###########################################################################

CANVAS_API_TOKEN= # your canvas api token here (canvas > account > settings)
CANVAS_API_URL=https://canvas.asu.edu/api/v1

# Model provider is OpenAI-compatible — swap providers by editing these three vars only.
# dev profile — ASU endpoint (free, VPN/account-gated):
OPENAI_API_KEY= # ASU RC provided api key from voyager
OPENAI_BASE_URL=https://openai.rc.asu.edu/v1

# prod profile — Groq (free tier, publicly reachable). To use, replace the three above:
# OPENAI_API_KEY=your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile

###########################################################################
# LLM
###########################################################################

MODEL_NAME=qwen3-30b-a3b-instruct-2507
TEMPERATURE=0.2

###########################################################################
# Tavily (news ingestion; used in a later v2 plan)
###########################################################################

# TAVILY_API_KEY=your-tavily-key

###########################################################################
# Supabase (backend)
###########################################################################

SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_JWT_SECRET=...
FRONTEND_ORIGIN=http://localhost:3000

###########################################################################
# Feature flags
###########################################################################

# Major-map extraction launches headless Chromium (Playwright) during onboarding.
# Disabled by default for the RAM-light demo deploy (Render free): /api/major-map/generate
# returns 503 and the browser never launches. Set to true (on a host with enough RAM +
# Chromium) to restore it; pair with NEXT_PUBLIC_MAJOR_MAP_ENABLED=true on the frontend.
MAJOR_MAP_ENABLED=false
